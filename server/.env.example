# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on.
PORT=8787

# Public base URL that phones use to reach this server (must be HTTPS for the
# phone microphone and camera). In development, use a tunnel such as:
#   cloudflared tunnel --url http://localhost:8787
# and paste the https://....trycloudflare.com address here.
PUBLIC_URL=http://localhost:8787

# demo  = no AWS needed: bundled stories, on-device scenes, no narration audio
# aws   = live Amazon Bedrock + Amazon Polly
MODE=demo

# AWS region for Bedrock text/vision (Nova Lite) and Polly.
AWS_REGION=ap-southeast-2

# Credentials: either set these, or use an AWS profile / instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Text + vision model (Amazon Nova Lite).
TEXT_MODEL_ID=amazon.nova-lite-v1:0

# Background paintings:
#   canvas = Amazon Nova Canvas (needs a region that offers it, e.g. us-east-1)
#   none   = the TV paints scenes itself from a setting name (no image model)
IMAGE_MODE=none
CANVAS_REGION=us-east-1
CANVAS_MODEL_ID=amazon.nova-canvas-v1:0

# Narrator voice (Amazon Polly). Hear them all with `npm run try:voices`.
# Voices with a generative variant (Ruth, Danielle, Joanna, Matthew, Amy, Brian,
# Olivia, ...) use Polly's expressive generative engine; set POLLY_GENERATIVE=false
# to use neural voices only. Child voices (Ivy, Kevin, Justin) are always neural.
POLLY_VOICE=Ruth
POLLY_ENGINE=neural
POLLY_GENERATIVE=true

# Optional Amazon Bedrock Guardrail for child-safe input and output.
# Leave empty to rely on the built-in prompt rules and word filter only.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Cost protection for a public demo.
MAX_STORIES_PER_DAY=80
MEDIA_TTL_HOURS=24

# Pin the "draw it into the story" moment (handy when recording a demo):
#   friend = the story always asks the child to draw a new friend (act 2)
#   thing  = the story always asks for an object (act 1)
#   empty  = random
STORY_DRAW=
